# Dravya IQ configuration. Copy to .env and fill in. Never commit .env.
# Every variable the application reads appears here, with a comment and no secret value.

# --- Core ---
# development enables /api/demo/reset
APP_ENV=development
APP_PORT=8000
# Name printed on certificates
PLANT_NAME=Sample Masterbatch Plant

# --- Storage ---
# SQLite path. Leave as is for local v1.
DATABASE_URL=sqlite:///data/dravya.db

# --- Photo reader (optional) ---
# The whole journey works without these. Unset means live reading is hidden
# and the app offers prepared readings and typing.
# none | fake | anthropic
MODEL_PROVIDER=
# A vision-capable model id. Check the provider's current docs, do not guess.
MODEL_ID=
MODEL_API_KEY=
# Seconds before a read gives up and opens the capture for typing
READER_TIMEOUT_S=60
# Upload ceiling in megabytes
UPLOAD_MAX_MB=8
